{
  "name": "nodalwire-docs-tooling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --project tsconfig.json",
    "test": "node --test tests/*.test.mjs && uv run --locked python -m unittest discover -s tests -p '*_test.py'",
    "verify": "pnpm check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@devcapsule/adapter": "https://npm.jsr.io/~/11/@jsr/devcapsule__adapter/4.0.0.tgz",
    "colorjs.io": "0.7.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
