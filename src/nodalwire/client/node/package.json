{
  "name": "@devcapsule/nodalwire-client",
  "version": "0.3.0",
  "description": "Network membership and byte client for the local NodalWire relay",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm run clean && node node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node node_modules/typescript/bin/tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json",
    "test:native": "node --test '../../../../tests/unit/nodalwire/client/node/src/*.test.mjs' '../../../../tests/integration/nodalwire/client/node/*.test.mjs'",
    "test:unit": "pnpm run build && pnpm run test:native",
    "test:interop": "python ../../../../tests/integration/nodalwire/client/node/interop.py",
    "test:artifact": "python ../../../../tests/integration/nodalwire/client/node/package_smoke.py",
    "test": "pnpm run check && pnpm run build && pnpm run test:native && pnpm run test:interop"
  },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=24 <25" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenlycode/nodalwire.git",
    "directory": "src/nodalwire/client/node"
  },
  "bugs": { "url": "https://github.com/keenlycode/nodalwire/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "dependencies": { "zeromq": "6.8.0" },
  "devDependencies": { "@types/node": "24.10.1", "typescript": "5.9.3" }
}
